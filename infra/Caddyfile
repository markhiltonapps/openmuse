{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# Backdrop clips don't change once made (a new one gets a new name): kept for a week.
	@backdrops path /backdrops/*
	header @backdrops Cache-Control "public, max-age=604800"
	@fresh not path /_expo/static/* /backdrops/*
	header @fresh Cache-Control "no-cache"
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"
	try_files {path} /index.html
	file_server
}
