# The voice service (apps/voice). Copy to .env for a local run; on Railway these are the voice
# service's Variables (choose Deploy on the banner after adding or changing one).

# Shared with the api (its VOICE_INTERNAL_TOKEN): every request from the api is signed with it.
VOICE_INTERNAL_TOKEN=

# Listening: Soniox real-time speech-to-text ("fake" for a local run without keys).
VOICE_STT=soniox
SONIOX_API_KEY=
# SONIOX_MODEL=stt-rt-v5

# Thinking: a Claude model, with its instructions cached.
ANTHROPIC_API_KEY=  # on Railway, a reference to the api's: ${{api.ANTHROPIC_API_KEY}}
# VOICE_LLM_MODEL=claude-haiku-4-5
# VOICE_LLM_MAX_TOKENS=300

# Speaking: inworld (TTS-2 Flash) or speechify (Simba 3.2) ("fake" for a local run).
VOICE_TTS=inworld
INWORLD_API_KEY=
# INWORLD_TTS_MODEL=inworld-tts-2-flash
# INWORLD_VOICE=Ashley
SPEECHIFY_API_KEY=
# SPEECHIFY_TTS_MODEL=simba-3.2
# SPEECHIFY_VOICE=geffen_32

# Turn-taking: how long a pause must last before the turn model is asked if they've finished.
# VOICE_VAD_STOP_SECS=0.2

# Capacity: worker processes, and calls each takes (about 4 per CPU core).
# VOICE_WORKERS=2
# VOICE_CALLS_PER_WORKER=4
# The relay transport the service uses when Railway won't let UDP out: udp (default), tcp or tls.
# VOICE_TURN_TRANSPORT=udp

# Where it listens: "::" on Railway (its private network is IPv6), 0.0.0.0 or 127.0.0.1 locally.
# HOST=::
# PORT=8080
