{
  "name": "Neato_Meca",
  "short_name": "Neato_Meca",
  "description": "A personal agent for your mail, calendar, apps and errands.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FBFBFB",
  "theme_color": "#FBFBFB",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  }
}
